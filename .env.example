# Public browser configuration. Copy to .env.local.
# Never put secret keys, service_role or database passwords in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only online battles. Enter personally; never commit a real value.
# sb_secret_ key from the same Supabase project; no VITE_ prefix.
SUPABASE_SECRET_KEY=
